{
  "manifest_version": 3,
  "name": "Deckly",
  "version": "1.0.0",
  "description": "A simple, tidy, and comfortable taskboard in your Chrome side panel.",
  "minimum_chrome_version": "114",
  "permissions": ["storage", "sidePanel", "alarms", "notifications"],
  "action": {
    "default_title": "Open Deckly",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
